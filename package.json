{
  "name": "appium-automation",
  "version": "1.0.0",
  "private": true,
  "description": "End-to-end mobile UI tests for the Cadence Android app, built with Appium, WebdriverIO and TypeScript.",
  "type": "module",
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "emulator:setup": "node scripts/setup-emulator.mjs",
    "emulator:start": "node scripts/start-emulator.mjs",
    "app:download": "node scripts/download-apk.mjs",
    "driver:install": "appium driver install uiautomator2",
    "doctor": "appium driver doctor uiautomator2",
    "test": "wdio run config/wdio.android.conf.ts",
    "test:smoke": "wdio run config/wdio.android.conf.ts --mochaOpts.grep @smoke",
    "test:ci": "wdio run config/wdio.ci.conf.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "report": "allure generate reports/allure-results --clean -o reports/allure-report && allure open reports/allure-report"
  },
  "author": "Saad Iftikhar",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.6.5",
    "@wdio/allure-reporter": "^10.1.0",
    "@wdio/appium-service": "^10.1.0",
    "@wdio/cli": "^10.1.0",
    "@wdio/globals": "^10.1.0",
    "@wdio/local-runner": "^10.1.0",
    "@wdio/mocha-framework": "^10.1.0",
    "@wdio/spec-reporter": "^10.1.0",
    "@wdio/types": "^10.0.1",
    "allure-commandline": "^2.46.1",
    "appium": "^3.8.0",
    "appium-uiautomator2-driver": "^8.7.0",
    "eslint": "^10.13.0",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.72.0",
    "webdriverio": "^10.0.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "appium@3.8.0": true
  }
}
